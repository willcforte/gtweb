---
import { SITE } from '../consts'

interface Props {
    title: string
    description: string
    kind?: 'website' | 'article'
    published?: Date
    updated?: Date
    tags?: string[]
    ogImage?: string
    noindex?: boolean
}

const {
    title,
    description,
    kind = 'website',
    published,
    updated,
    tags = [],
    ogImage,
    noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url)
const image = new URL(ogImage ?? '/og-default.png', Astro.site ?? SITE.url)
const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`

const personLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    sameAs: [
        'https://github.com/willcforte',
        'https://www.linkedin.com/in/willcforte/',
        'https://bsky.app/profile/willcforte.com',
    ],
}

const articleLd = published && {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: image.href,
    datePublished: published.toISOString(),
    dateModified: (updated ?? published).toISOString(),
    keywords: tags.join(', '),
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
    mainEntityOfPage: canonical.href,
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={kind} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={image.href} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />

{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
{articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />}
