---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { postsOfType, writingTypes } from '../../utils/posts'

const posts = await postsOfType(...writingTypes)
---

<BaseLayout
    title="Writing"
    description="Essays and logs — Will's own words, arguing a position or reporting what happened."
>
    <div class="wrap-narrow stack">
        <header>
            <h1>Writing</h1>
            <p class="lede">
                Essays that argue a position and logs that report what happened — the things Will
                wrote himself, as opposed to notes taken from someone else's material.
            </p>
        </header>

        {
            posts.length === 0 ? (
                <p class="empty">Nothing published yet.</p>
            ) : (
                <ul role="list" class="posts">
                    {posts.map((post) => (
                        <li>
                            <PostCard post={post} showType />
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</BaseLayout>

<style>
    header {
        padding-block: var(--space-xl) var(--space-l);
    }

    h1 {
        font-family: var(--font-ui);
        font-size: var(--step-4);
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .lede {
        font-family: var(--font-prose);
        font-size: var(--step-1);
        color: var(--fg-muted);
        margin-block-start: var(--space-s);
    }

    .posts {
        padding: 0;
        margin-block-end: var(--space-2xl);
    }

    .posts li {
        padding-block: var(--space-m);
        border-block-end: 1px solid var(--rule-faint);
    }

    .empty {
        font-family: var(--font-prose);
        color: var(--fg-muted);
        font-style: italic;
        padding-block: var(--space-l);
    }
</style>
