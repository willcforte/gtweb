---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { allPosts, allTags } from '../../utils/posts'

export async function getStaticPaths() {
    const tags = await allTags()
    const posts = await allPosts()

    return tags.map(({ tag }) => ({
        params: { tag },
        props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
    }))
}

const { tag } = Astro.params
const { posts } = Astro.props
---

<BaseLayout title={`#${tag}`} description={`Posts tagged #${tag}.`}>
    <div class="wrap-narrow stack">
        <header>
            <h1>#{tag}</h1>
            <p class="lede">Every post tagged #{tag}, newest first.</p>
        </header>

        {
            posts.length === 0 ? (
                <p class="empty">No posts with this tag.</p>
            ) : (
                <ul role="list" class="posts">
                    {posts.map((post) => (
                        <li>
                            <PostCard post={post} showType />
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</BaseLayout>

<style>
    header {
        padding-block: var(--space-xl) var(--space-l);
    }

    h1 {
        font-family: var(--font-ui);
        font-size: var(--step-4);
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .lede {
        font-family: var(--font-prose);
        font-size: var(--step-1);
        color: var(--fg-muted);
        margin-block-start: var(--space-s);
    }

    .posts {
        padding: 0;
        margin-block-end: var(--space-2xl);
    }

    .posts li {
        padding-block: var(--space-m);
        border-block-end: 1px solid var(--rule-faint);
    }

    .empty {
        font-family: var(--font-prose);
        color: var(--fg-muted);
        font-style: italic;
        padding-block: var(--space-l);
    }
</style>
