---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'

import BaseLayout from '../../layouts/BaseLayout.astro'
import PostMeta from '../../components/PostMeta.astro'
import Giscus from '../../components/Giscus.astro'
import {
    postUrl,
    seriesSiblings,
    relatedPosts,
    writingTypes,
    formatDateShort,
} from '../../utils/posts'

export async function getStaticPaths() {
    const posts = await getCollection('posts')
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { data } = post
const { Content, headings } = await render(post)

const siblings = await seriesSiblings(post)
const index = siblings.findIndex((p) => p.id === post.id)
const previous = index > 0 ? siblings[index - 1] : null
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : null

const related = await relatedPosts(post)

/* Comments are for Will's own writing, not for sourced course notes. */
const showComments = writingTypes.includes(data.type)

/* A table of contents only earns its space on genuinely long pieces. */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const showToc = toc.length >= 4
---

<BaseLayout
    title={data.title}
    description={data.description}
    kind="article"
    published={data.date}
    updated={data.updated}
    tags={data.tags}
    ogImage={`/og/${post.id}.png`}
>
    <article>
        <header class="post-header wrap-narrow">
            <h1>{data.title}</h1>
            <p class="lede">{data.description}</p>
            <PostMeta post={post} />
            {
                data.source && (
                    <p class="source label">
                        Source: <span>{data.source}</span>
                    </p>
                )
            }
        </header>

        {
            data.hero && (
                <figure class="hero wrap">
                    <Image src={data.hero} alt={data.heroAlt ?? ''} widths={[480, 800, 1200]} />
                </figure>
            )
        }

        {
            showToc && (
                <nav class="toc wrap-narrow" aria-label="Table of contents">
                    <h2 class="label">Contents</h2>
                    <ol role="list">
                        {toc.map((h) => (
                            <li data-depth={h.depth}>
                                <a href={`#${h.slug}`}>{h.text}</a>
                            </li>
                        ))}
                    </ol>
                </nav>
            )
        }

        <div class="prose">
            <Content />
        </div>

        {
            (previous || next) && (
                <nav class="series wrap-narrow" aria-label="Series navigation">
                    <h2 class="label">More in {data.series}</h2>
                    <div class="series-links">
                        {previous ? (
                            <a href={postUrl(previous)} rel="prev">
                                <span class="label">Previous</span>
                                {previous.data.title}
                            </a>
                        ) : (
                            <span />
                        )}
                        {next && (
                            <a href={postUrl(next)} rel="next" class="to-next">
                                <span class="label">Next</span>
                                {next.data.title}
                            </a>
                        )}
                    </div>
                </nav>
            )
        }

        {
            related.length > 0 && (
                <aside class="related wrap-narrow">
                    <h2 class="label">Related</h2>
                    <ul role="list">
                        {related.map((p) => (
                            <li>
                                <a href={postUrl(p)}>{p.data.title}</a>
                                <span class="label">{formatDateShort(p.data.date)}</span>
                            </li>
                        ))}
                    </ul>
                </aside>
            )
        }

        {showComments && <div class="wrap-narrow"><Giscus /></div>}
    </article>
</BaseLayout>

<style>
    .post-header {
        padding-block: var(--space-xl) var(--space-l);
    }

    .post-header h1 {
        font-family: var(--font-ui);
        font-size: var(--step-5);
        font-weight: 700;
        line-height: var(--leading-tight);
        letter-spacing: -0.03em;
        text-wrap: balance;
    }

    .lede {
        font-family: var(--font-prose);
        font-size: var(--step-2);
        line-height: 1.4;
        color: var(--fg-muted);
        text-wrap: pretty;
        margin-block: var(--space-s) var(--space-m);
    }

    .source {
        margin-block-start: var(--space-s);
    }

    .source span {
        text-transform: none;
        letter-spacing: 0;
    }

    .hero {
        margin-block-end: var(--space-xl);
    }

    .hero :global(img) {
        inline-size: 100%;
        block-size: auto;
        border: 1px solid var(--rule);
    }

    .toc {
        margin-block-end: var(--space-xl);
        padding: var(--space-m);
        border: 1px solid var(--rule);
        background: var(--bg-raised);
    }

    .toc ol {
        margin-block-start: var(--space-xs);
        padding: 0;
        list-style: none;
    }

    .toc li[data-depth='3'] {
        padding-inline-start: var(--space-m);
    }

    .toc a {
        text-decoration: none;
    }

    .toc a:hover {
        text-decoration: underline;
    }

    .series,
    .related {
        margin-block-start: var(--space-xl);
        padding-block-start: var(--space-m);
        border-block-start: 1px solid var(--rule);
    }

    .series-links {
        display: flex;
        justify-content: space-between;
        gap: var(--space-m);
        margin-block-start: var(--space-xs);
    }

    .series-links a {
        display: flex;
        flex-direction: column;
        gap: 2px;
        text-decoration: none;
        max-inline-size: 22ch;
    }

    .series-links .to-next {
        text-align: end;
        margin-inline-start: auto;
    }

    .series-links a:hover {
        text-decoration: underline;
    }

    .related ul {
        margin-block-start: var(--space-xs);
        padding: 0;
    }

    .related li {
        display: flex;
        justify-content: space-between;
        gap: var(--space-m);
        padding-block: var(--space-2xs);
    }
</style>
