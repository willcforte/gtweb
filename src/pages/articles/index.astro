---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { entryPath } from '../../utils/entry-path';

const articles = (await getCollection('content', (e) => e.id.startsWith('articles/') && e.data.status === 'done'))
    .sort((a, b) => (a.data.unix! < b.data.unix! ? 1 : -1));
---
<Base>
    <h1 class="mb-4">Logs</h1>

    Here are some work-in-progress engineering projects and trains of thought.  <a href="/feed.rss">RSS Feed</a>

    <h4>View my finished projects <a href="/robotics">here</a>.</h4>

    {articles.map((entry) => (
        <div class="mb-3">
            <a href={`/${entry.id}`}>{entry.data.image && <img class="medarticleimg" src={entryPath(entry, entry.data.image)} alt="Cover Image" />}</a>
            <h2 class="my-0 py-0 text-3xl"><a href={`/${entry.id}`}>{entry.data.title}</a></h2>
            <p class="text-xs pt-0 my-0 py-0">{entry.data.date} • {entry.data.bytes} • {entry.data.type}</p>
        </div>
    ))}
</Base>
