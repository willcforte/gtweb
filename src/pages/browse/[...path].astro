---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { browsableDirs, isDir, isLeaf, ls, root } from '../../utils/content-tree';

export function getStaticPaths() {
    return ['', ...browsableDirs()].map((d) => ({ params: { path: d || undefined } }));
}

const dir = Astro.params.path ?? '';
const entries = new Map((await getCollection('content')).map((e) => [e.filePath, e]));
const page = (file: string) => {
    const entry = entries.get(`${root}/${file}`);
    return { href: entry?.id === 'index' ? '/' : `/${entry?.id}`, title: entry?.data.title };
};

const items = ls(dir).map((name) => {
    const rel = dir ? `${dir}/${name}` : name;
    if (isDir(rel)) {
        return isLeaf(rel) ? { name: `${name}/`, ...page(`${rel}/index.md`) } : { name: `${name}/`, href: `/browse/${rel}` };
    }
    return name.endsWith('.md') ? { name, ...page(rel) } : { name, href: `/${rel}` };
});
const parent = dir.includes('/') ? `/browse/${dir.slice(0, dir.lastIndexOf('/'))}` : '/browse';
---
<Base title={`content/${dir}`}>
    <h1 class="mb-4">content/{dir && `${dir}/`}</h1>
    <ul class="list-none">
        {dir && <li><span class="link"><a href={parent}>../</a></span></li>}
        {items.map(({ name, href, title }) => (
            <li><span class="link"><a href={href}>{name}</a></span>{title && <span> — {title}</span>}</li>
        ))}
    </ul>
</Base>
